{
    "name": "@0dexz0/simple-chess-board",
    "version": "0.5.0",
    "description": "An open-source chessboard library focused on simplicity, with real-time style customization and flexible interactivity.",
    "keywords": [
        "chess",
        "chessboard",
        "vanilla",
        "chess-ui"
    ],
    "license": "MPL-2.0",
    "author": "0Dexz0",
    "type": "module",
    "main": "./src/core/SimpleChessBoard.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/0Dexz0/SimpleChessBoard"
    },
    "homepage": "https://0dexz0.github.io/SimpleChessBoard/",
    "sideEffects": [
        "./src/styles/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "types": "./dist-types/core/SimpleChessBoard.d.ts",
    "exports": {
        ".": {
            "types": "./dist-types/core/SimpleChessBoard.d.ts",
            "default": "./src/core/SimpleChessBoard.js"
        },
        "./helpers": {
            "types": "./dist-types/helpers/chess-helpers.d.ts",
            "default": "./src/helpers/chess-helpers.js"
        },
        "./config": {
            "types": "./dist-types/config/index.d.ts",
            "default": "./src/config/index.js"
        },
        "./themes": {
            "types": "./dist-types/themes/index.d.ts",
            "default": "./src/themes/index.js"
        },
        "./types": {
            "types": "./dist-types/types/SimpleChessBoard.types.d.ts",
            "default": "./src/types/SimpleChessBoard.types.js"
        },
        "./assets": {
            "types": "./dist-types/assets/index.d.ts",
            "default": "./src/assets/index.js"
        }
    },
    "files": [
        "src",
        "dist-types",
        "GUIDE.md"
    ],
    "scripts": {
        "pack": "npm pack --pack-destination ./tgz"
    },
    "dependencies": {
        "chess.js": "1.4.0"
    },
    "devDependencies": {
        "typescript": "^6.0.3"
    }
}
